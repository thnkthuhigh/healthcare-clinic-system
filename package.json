{
  "name": "healthcare-clinic-system",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n BACKEND,WEB -c magenta,cyan \"npm run dev -w apps/backend\" \"npm run dev -w apps/web\"",
    "db:refresh": "docker exec clinic_postgres psql -U postgres -d clinic_dev -c \"SELECT refresh_demo_data();\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:backend": "npm run dev -w apps/backend",
    "dev:web": "npm run dev -w apps/web",
    "web:refresh": "npm run build -w apps/web && docker compose restart web",
    "build": "npm run build --workspaces",
    "check": "npm run lint && npm run typecheck && npm run format:check",
    "check:all": "npm run check && npm run build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier -w . --ignore-unknown",
    "format:check": "prettier -c . --ignore-unknown",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:rebuild": "docker compose down && docker compose build --no-cache && docker compose up -d",
    "test:e2e:prepare": "node tests/e2e/scripts/prepare.mjs",
    "test:e2e": "node tests/e2e/scripts/prepare.mjs && playwright test",
    "test:e2e:headed": "node tests/e2e/scripts/prepare.mjs && playwright test --headed",
    "test:e2e:report": "playwright show-report playwright-report/e2e",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "eslint-plugin-unused-imports": "^3.1.0",
    "husky": "^9.0.11",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "react-qr-code": "^2.0.18"
  }
}
