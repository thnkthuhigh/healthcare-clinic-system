# Copy this file to .env for local Docker Compose overrides.

SMS_PROVIDER=twilio
SMS_BRAND_NAME=Healthcare Clinic
SMS_DEFAULT_COUNTRY_CODE=84
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:4000/api/v1/payments/vnpay/return
VNPAY_EXPIRE_MINUTES=15
VNPAY_MOCK_ENABLED=true
